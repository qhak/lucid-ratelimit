{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lucid-ratelimit-tests",
  "main": "tests/worker.ts",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimitDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimitDurableObject"],
    },
  ],
}
